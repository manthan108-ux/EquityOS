# Copy this file to `.env` (same folder) and adjust. `.env` is git-ignored; never commit real secrets.

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=equityos
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=equityos
# Host port for the Docker database. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_HOST_PORT=5433

# --- Backend ---
ENVIRONMENT=development
# When running the backend on your machine (not in Docker), it reaches Docker's Postgres via the host port:
DATABASE_URL=postgresql+psycopg://equityos:change-me-locally@localhost:5433/equityos
CORS_ORIGINS=["http://localhost:3000"]

# Where documents, the HTTP cache and the manual-ingestion inbox live. Relative paths start at the
# repo root. Docker bind-mounts this same folder (DATA_HOST_DIR, default ./data), so local runs and
# Docker see the same files. On Linux also set DATA_UID / DATA_GID to the owner of the folder.
DATA_DIR=data
# DATA_HOST_DIR=./data
# DATA_UID=1000
# DATA_GID=1000

# --- Frontend ---
# Address the BROWSER uses to reach the backend (inlined at build time by Next.js).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM providers (introduced in Phase 9; free tiers only) ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Model names are configuration (defaults shown); LLM_PRIMARY picks which provider is tried first.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash
# LLM_PRIMARY=groq

# --- Data providers (optional; a provider without credentials reports UNCONFIGURED) ---
# Upstox Fundamentals API (income statements, balance sheets, cash flows, shareholding, ratios,
# corporate actions, competitors). Generate the free read-only Analytics Token (valid 1 year) in
# the Upstox Developer Apps page > Analytics tab. Keep it secret; do not share or commit it.
UPSTOX_ANALYTICS_TOKEN=
# Feature flag: UPSTOX_ENABLED=false switches the connector off even when a token is set.
# UPSTOX_ENABLED=true
# data.gov.in free API key (government statistics)
DATA_GOV_IN_API_KEY=
